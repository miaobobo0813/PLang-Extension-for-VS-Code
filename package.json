{
  "name": "plang",
  "displayName": "PLang",
  "description": "PLang language support for VS Code",
  "publisher": "miaobobo0813",
  "version": "0.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/miaobobo0813/PLang-Extension-for-VS-Code"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "plang",
        "aliases": [
          "PLang",
          "plang"
        ],
        "extensions": [
          ".plang"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plang",
        "scopeName": "source.plang",
        "path": "./syntaxes/plang.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p client && tsc -p server",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@typescript/native": "^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  }
}
